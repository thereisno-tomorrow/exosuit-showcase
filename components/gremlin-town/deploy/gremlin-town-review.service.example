# INACTIVE example; installing gremlin-town.service does not install this unit.
# Requires [review] enabled = true in config.toml, exosuit-review enrolled with
# a route to hermes-wa and a read-only Brain Home grant (step E spec §10), the
# Telegram courier and its spool folder (docs/operations.md, step E), and a dry
# run by hand first. Hands the 06:00 review to Diablo as a GT request; the courier
# posts its text on Telegram. A disabled [review] reads, spools and sends nothing.
[Unit]
Description=Exosuit 06:00 review (step E)
After=gremlin-town.service

[Service]
Type=oneshot
User=gremlin-town
Group=gremlin-town
WorkingDirectory=/opt/gremlin-town/current
# The same environment and credentials as gremlin-town.service and its drop-ins: building the
# runtime needs the GitHub transport's credentials, and it opens the connections store.
EnvironmentFile=/etc/gremlin-town/service.env
LoadCredential=github_messages_token:/etc/gremlin-town/github-messages-token
Environment=GT_GITHUB_TOKEN_FILE=%d/github_messages_token
LoadCredential=github_app_key:/etc/gremlin-town/github-app-gt.pem
Environment=GT_GITHUB_APP_KEY_FILE=%d/github_app_key
ExecStart=/opt/gremlin-town/current/.venv/bin/gremlin-town review run --config /etc/gremlin-town/config.toml
# Then post what the run spooled ([review] telegram_spool_dir) to Nic's Telegram with Hermes's
# own `hermes send` in Diablo's container (deploy/telegram-courier.sh; Diablo's Hermes lets no
# agent send on its own). The "+" runs it as root, outside this unit's sandbox and user:
# `docker exec` needs root, which gremlin-town must never have. It runs only if ExecStart succeeded.
ExecStartPost=+/usr/local/lib/gremlin-town/telegram-courier.sh /var/lib/gremlin-town-brain/why/spool
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/gremlin-town /var/lib/gremlin-town-brain
ReadWritePaths=-/var/lib/gremlin-town-oauth
