[Unit]
Description=Gremlin Town + Brain Core daily triage (read-only on hub data)
After=gremlin-town.service

[Service]
Type=oneshot
User=gremlin-town
Group=gremlin-town
WorkingDirectory=/opt/gremlin-town/current
ExecStart=/opt/gremlin-town/current/.venv/bin/gremlin-town triage run --config /etc/gremlin-town/config.toml --state-dir /var/lib/gremlin-town-brain/triage
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Hub data is opened read-only; SQLite WAL readers still need the directory writable
# for the shared-memory file. Only the triage directory is written.
ReadWritePaths=/var/lib/gremlin-town /var/lib/gremlin-town-brain/decision-staging /var/lib/gremlin-town-brain/triage
