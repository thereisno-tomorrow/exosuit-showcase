          "title",
          "choice",
          "because",
          "forecloses",
          "governing_scope",
          "encoded_in",
          "completeness_check"
        ],
        "type": "object"
      }
    },
    {
      "name": "bc_memory_change",
      "description": "Change one item, fact or preference already in Brain Home: state, level, timing, importance or links. Reads the record first for its record_id and expected_sha256 (its content hash); refused as changed once it is no longer the newest version, even if that hash still matches (records are immutable, so their own hash never moves), so two changes from the same read cannot both land. done needs data.check from someone other than the agent claiming it. said_by=owner with came_by=direct is required to raise level to accepted or to mark an item dropped, parked or no_longer_needed. time_words is only the time part, his words even if said apart (tmr at 12pm; next week's, not before next week's exam); the server resolves it to a date, never invents one; if refused, shorten it, never drop it. words is what Nic said about the thing, never your instruction to save it; if his message is only that, quote the earlier message it refers to instead. Nic's own words that he will, must, needs to or has to do something are level accepted: save them once at that level, not as a suggestion to raise later. Brain Home holds anything Nic would be hurt to lose or have done late (tasks, promises, dates, people he waits on, decisions); your own memory holds only how you work, and Brain wins a clash. importance=confirmed needs Nic's yes as words. sort checks an outcome's parts, as on bc_memory_save. For a routine, Nic's \"did it\" is occurrence=done in his words: it stays open. Choose and retain operation_id before calling. After an uncertain response, replay with exactly the same input, never a replacement key. Returns a receipt: saved means status accepted or duplicate with remote_observed true, naming the record in record_id. ",
      "input_schema": {
        "$defs": {
          "MemoryLinkInput": {
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "part_of",
                  "waiting_on",
                  "blocked_by",
                  "handed_to",
                  "about",
                  "replaces",
                  "came_from"
                ],
                "type": "string"
              },
              "target": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "type",
              "target"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,127}$",
            "type": "string"
          },
          "scope": {
            "enum": [
              "personal",
              "cross-project",
              "system",
              "fleet",
              "project"
            ],
            "type": "string"
          },
          "record_id": {
            "pattern": "^brn_\\d{8}_\\d{6}_[0-9a-f]{4,16}$",
            "type": "string"
          },
          "expected_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "said_by": {
            "description": "Who said the words: owner, agent, or other.",
            "enum": [
              "owner",
              "agent",
              "other"
            ],
            "type": "string"
          },
          "came_by": {
            "description": "How the words reached the server: direct, agent_guess, connected_source, or system. The server refuses a value other than direct when said_by is owner.",
            "enum": [
              "direct",
              "agent_guess",
              "connected_source",
              "system"
            ],
            "type": "string"
          },
          "words": {
            "description": "The exact words, quoted verbatim. The server refuses a missing value unless came_by is system.",
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "speaker": {
            "description": "Who spoke the words. The server refuses a missing value when said_by is agent or other.",
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "source_reference": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "project_id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "type": "string"
          },
          "state": {
            "enum": [
              "open",
              "waiting",
              "blocked",
              "parked",
              "done",
              "dropped",
              "no_longer_needed",
              "current",
              "outdated"
            ],
            "type": "string"
          },
          "level": {
            "enum": [
              "possible",
              "suggested",
              "accepted"
            ],
            "type": "string"
          },
          "size": {
            "enum": [
              "task",
              "goal"
            ],
            "type": "string"
          },
          "owed_to": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "repeat": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "time_words": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "check_locator": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "checked_by": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "parked_until": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "links": {
            "default": [],
            "items": {
              "$ref": "#/$defs/MemoryLinkInput"
            },
            "maxItems": 20,
            "type": "array"
          },
          "importance": {
            "enum": [
              "proposed",
              "confirmed",
              "real_cost",
              "minor",
              "normal"
            ],
            "type": "string"
          },
          "importance_reason": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "block": {
            "enum": [
              "deep_focus",
              "admin",
              "errands"
            ],
            "type": "string"
          },
          "rough_minutes": {
            "maximum": 1440,
            "minimum": 1,
            "type": "integer"
          },
          "length_is_nics": {
            "default": false,
            "type": "boolean"
          },
          "raise_with": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "sort": {
            "enum": [
              "next_action",
              "waiting_on",
              "raise_with",
              "someday",
              "reference",
              "drop"
            ],
            "type": "string"
          },
          "first_step": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$",
            "type": "string"
          },
          "occurrence": {
            "const": "done",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "scope",
          "record_id",
          "expected_sha256",
          "said_by",
          "came_by"
        ],
        "type": "object"
      }
    },
    {
      "name": "bc_memory_list",
      "description": "List Nic's items from Brain Home: accepted items in open, waiting or blocked by default (word, state and level narrow or widen this), sorted by due date first (a window by its start; undated last) then most recently updated. Omit level to have it follow word (idea is level=possible, suggestion is level=suggested, everything else is level=accepted); pass level explicitly to filter to it exactly, including accepted alongside word=idea or word=suggestion. Use this for 'what's open', 'what did I ask', 'anything due'. Search is for recall by topic. kind=preference lists Nic's confirmed preferences instead, newest first; facts have search. Each result carries expected_sha256, so bc_memory_change can follow with no read. ",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "scope": {
            "default": "personal",
            "enum": [
              "personal",
              "cross-project",
              "system",
              "fleet",
              "project"
            ],
            "type": "string"
          },
          "project_id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "type": "string"
          },
          "word": {
            "enum": [
              "idea",
              "suggestion",
              "task",
              "promise",
              "routine",
              "goal"
            ],
            "type": "string"
          },
          "state": {
            "default": [
              "open",
              "waiting",
              "blocked"
            ],
            "items": {
              "enum": [
                "open",
                "waiting",
                "blocked",
                "parked",
                "done",
                "dropped",
                "no_longer_needed",
                "current",
                "outdated"
              ],
              "type": "string"
            },
            "maxItems": 9,
            "minItems": 1,
            "type": "array"
          },
          "level": {
            "anyOf": [
              {
                "enum": [
                  "possible",
                  "suggested",
                  "accepted"
                ],
                "type": "string"
              },
              {
                "items": {
                  "enum": [
                    "possible",
                    "suggested",
                    "accepted"
                  ],
                  "type": "string"
                },
                "maxItems": 3,
                "minItems": 1,
                "type": "array"
              }
            ],
            "description": "Filter to this exact level, or to several: [\"accepted\", \"suggested\"] lists tasks and suggestions in one call. Omit to infer it from word (idea -> possible, suggestion -> suggested, otherwise accepted); omitting both word and level lists accepted items, per the default."
          },
          "due_before": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "kind": {
            "default": "item",
            "enum": [
              "item",
              "preference"
            ],
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "bc_memory_read",
      "description": "Read one authorized memory record with version, hash and freshness, its plain word when applicable, and whether it is confirmed (every v1 capture or commitment reads back confirmed: false). A record already replaced by a change reads back freshness: stale with superseded_by naming its successor(s); re-read the successor before changing it again. ",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "scope": {
            "enum": [
              "personal",
              "cross-project",
              "system",
              "fleet",
              "project"
            ],
            "type": "string"
          },
          "record_id": {
            "pattern": "^brn_\\d{8}_\\d{6}_[0-9a-f]{4,16}$",
            "type": "string"
          },
          "project_id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "type": "string"
          }
        },
        "required": [
          "scope",
          "record_id"
        ],
        "type": "object"
      }
    },
    {
      "name": "bc_memory_save",
      "description": "Save executive memory to Brain Home with scope personal: items (idea/task/promise/routine/goal), sourced facts, and preferences. A preference is saved only from Nic's own words (said_by owner, came_by direct); a guessed preference is an item at level=suggested instead. A preference's focus_projects (project IDs) names Nic's focus projects; his newest list wins. Tags cannot perfectly classify arbitrary prose. Omit source_reference for the current user message: the server derives authenticated request provenance. Supply source_reference only for a previously enrolled document; never invent it. Put the full content in body: other agents cannot open private links such as claude.ai pages or local file paths. The confirmation carries the plain word, any resolved date, and links. Return validation versus acceptance explicitly. said_by=owner with came_by=direct is required to raise level to accepted or to mark an item dropped, parked or no_longer_needed. time_words is only the time part, his words even if said apart (tmr at 12pm; next week's, not before next week's exam); the server resolves it to a date, never invents one; if refused, shorten it, never drop it. words is what Nic said about the thing, never your instruction to save it; if his message is only that, quote the earlier message it refers to instead. Nic's own words that he will, must, needs to or has to do something are level accepted: save them once at that level, not as a suggestion to raise later. Brain Home holds anything Nic would be hurt to lose or have done late (tasks, promises, dates, people he waits on, decisions); your own memory holds only how you work, and Brain wins a clash. importance is the stake, with importance_reason (the loss, found by imagining it already slipped): real_cost or minor is your guess and counts at once; proposed means a loss that can't be undone, so ask Nic; importance=confirmed needs his yes as words. For a task, set block (deep_focus; admin, including calls and home jobs; errands) and rough_minutes, your guess of its length. Say the receipt's length.text; Nic's own number takes length_is_nics and his words. Sort anything new with sort: next_action needs block, first_step (the very next physical action: a verb and the thing, never decide, think about or work on) and rough_minutes; more than one step is a goal with its next action part_of it; never invent a date, contact or cause; waiting_on, a waiting_on link naming who; raise_with, raise_with; someday, level possible; reference, a fact. A missing part is refused. If it takes under two minutes, offer to do it with Nic now; if he'd rather not, save it as a next action. Choose and retain operation_id before calling. After an uncertain response, replay with exactly the same input, never a replacement key. Returns a receipt: saved means status accepted or duplicate with remote_observed true, naming the record in record_id. ",
      "input_schema": {
        "$defs": {
          "MemoryLinkInput": {
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "part_of",
                  "waiting_on",
                  "blocked_by",
                  "handed_to",
                  "about",
                  "replaces",
                  "came_from"
                ],
                "type": "string"
              },
              "target": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "type",
              "target"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,127}$",
            "type": "string"
          },
          "scope": {
            "enum": [
              "personal",
              "cross-project",
              "system",
              "fleet",
              "project"
            ],
            "type": "string"
          },
          "kind": {
            "enum": [
              "item",
              "fact",
              "preference"
            ],
            "type": "string"
          },
          "title": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "body": {
            "maxLength": 65536,
            "minLength": 1,
            "type": "string"
          },
          "said_by": {
            "description": "Who said the words: owner, agent, or other.",
            "enum": [
              "owner",
              "agent",
              "other"
            ],
            "type": "string"
          },
          "came_by": {
            "description": "How the words reached the server: direct, agent_guess, connected_source, or system. The server refuses a value other than direct when said_by is owner.",
            "enum": [
              "direct",
              "agent_guess",
              "connected_source",
              "system"
            ],
            "type": "string"
          },
          "words": {
            "description": "The exact words, quoted verbatim. The server refuses a missing value unless came_by is system.",
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "speaker": {
            "description": "Who spoke the words. The server refuses a missing value when said_by is agent or other.",
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "source_reference": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "project_id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "type": "string"
          },
          "dedupe_key": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "level": {
            "enum": [
              "possible",
              "suggested",
              "accepted"
            ],
            "type": "string"
          },
          "size": {
            "enum": [
              "task",
              "goal"
            ],
            "type": "string"
          },
          "owed_to": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "repeat": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "time_words": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "observed_at": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "valid_until": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "links": {
            "default": [],
            "items": {
              "$ref": "#/$defs/MemoryLinkInput"
            },
            "maxItems": 20,
            "type": "array"
          },
          "importance": {
            "enum": [
              "proposed",
              "confirmed",
              "real_cost",
              "minor",
              "normal"
            ],
            "type": "string"
          },
          "importance_reason": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "focus_projects": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          },
          "block": {
            "enum": [
              "deep_focus",
              "admin",
              "errands"
            ],
            "type": "string"
          },
          "rough_minutes": {
            "maximum": 1440,
            "minimum": 1,
            "type": "integer"
          },
          "length_is_nics": {
            "default": false,
            "type": "boolean"
          },
          "raise_with": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "sort": {
            "enum": [
              "next_action",
              "waiting_on",
              "raise_with",
              "someday",
              "reference",
              "drop"
            ],
            "type": "string"
          },
          "first_step": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "scope",
          "kind",
          "title",
          "body",
          "said_by",
          "came_by"
        ],
        "type": "object"
      }
    },
    {
      "name": "bc_memory_search",
      "description": "Search Brain Home personal or cross-project memories by topic or phrase, e.g. Clanker. Before answering from your own memory about Nic's tasks, promises, dates, people, decisions or what he said before, search here: your memory is not the record. Use this for recall when no record ID is known. Returns bounded matching records, each with its plain word when applicable, whether it is confirmed, and the observed repository version. Every v1 capture or commitment comes back confirmed: false. When a new topic comes up, search it for Nic's open ideas; mention each related one at most once per conversation, and it stays an idea unless he says so. ",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "scope": {
            "default": "personal",
            "enum": [
              "personal",
              "cross-project",
              "system",
              "fleet",
              "project"
            ],
            "type": "string"
          },
          "limit": {
            "default": 10,
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          },
          "project_id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      }
    },
