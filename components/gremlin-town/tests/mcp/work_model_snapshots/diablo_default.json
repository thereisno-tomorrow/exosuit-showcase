{
  "schema": "work-model.tool-snapshot/v1",
  "surface": "diablo",
  "feature_state": "default",
  "source_base": "d8d566d",
  "tools": [
    {
      "name": "bc_context_retrieve",
      "description": "Retrieve bounded current project context with version, hash, freshness and exclusion receipts. A project_id is vault_ plus the vault's name, e.g. vault_exosuit, here and in the note tools; a wrong one is answered with the valid IDs. ",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "maxLength": 128,
            "pattern": "^vault_[a-z0-9][a-z0-9_]*$",
            "type": "string"
          },
          "intent": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "max_sources": {
            "default": 12,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "max_source_tokens": {
            "default": 12000,
            "maximum": 12000,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "project_id",
          "intent"
        ],
        "type": "object"
      }
    },
    {
      "name": "bc_continuity_append",
      "description": "Append one supported Brain Core continuity event. Choose and retain operation_id before calling. After an uncertain response, replay with exactly the same input, never a replacement key. Returns a receipt: saved means status accepted or duplicate with remote_observed true, naming the record in record_id. ",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,127}$",
            "type": "string"
          },
          "session_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "event": {
            "enum": [
              "source",
              "effect",
              "decision",
              "commitment",
              "candidate",
              "blocker",
              "intent",
              "next_step"
            ],
            "type": "string"
          },
          "value": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "project_id": {
            "maxLength": 128,
            "pattern": "^vault_[a-z0-9][a-z0-9_]*$",
            "type": "string"
          },
          "scope": {
            "enum": [
              "personal",
              "cross-project",
              "system",
              "fleet",
              "project"
            ],
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "session_id",
          "event",
          "value"
        ],
        "type": "object"
      }
    },
    {
      "name": "bc_continuity_close",
