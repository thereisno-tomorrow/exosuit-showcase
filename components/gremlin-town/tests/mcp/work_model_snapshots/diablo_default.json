      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,127}$",
            "type": "string"
          },
          "session_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "project_id": {
            "maxLength": 128,
            "pattern": "^vault_[a-z0-9][a-z0-9_]*$",
            "type": "string"
          },
          "scope": {
            "enum": [
              "personal",
              "cross-project",
              "system",
              "fleet",
              "project"
            ],
            "type": "string"
          },
          "recovered": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "operation_id",
          "session_id"
        ],
        "type": "object"
      }
    },
    {
      "name": "bc_continuity_list",
      "description": "List open Brain Home continuity notes, newest first: session_id, task_id, intent, next_step and when each was last updated. ",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "maxLength": 128,
            "pattern": "^vault_[a-z0-9][a-z0-9_]*$",
            "type": "string"
          },
          "scope": {
            "enum": [
              "personal",
              "cross-project",
              "system",
              "fleet",
              "project"
            ],
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "bc_continuity_recover",
      "description": "Recover general Brain Home continuity by omitting project_id; supply project_id only for an explicitly named project. Supply session_id to recover one task's note instead of the latest. ",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "maxLength": 128,
            "pattern": "^vault_[a-z0-9][a-z0-9_]*$",
            "type": "string"
          },
