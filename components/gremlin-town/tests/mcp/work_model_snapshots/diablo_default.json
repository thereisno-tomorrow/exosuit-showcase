          "max_tokens": {
            "default": 2500,
            "maximum": 12000,
            "minimum": 80,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "bc_continuity_start",
      "description": "Start general continuity in Brain Home by omitting project_id; supply project_id only for an explicitly named project. Choose and retain operation_id before calling. After an uncertain response, replay with exactly the same input, never a replacement key. Returns a receipt: saved means status accepted or duplicate with remote_observed true, naming the record in record_id. Start this task's note (session_id gt-<request_id> for work handed through Gremlin Town) when work begins, and append next_step, and blocker or effect as they happen, after every meaningful step so it is current however the chat ends. Close it only when the task is done and checked. When asked what is still open, read the matching note for each open request. ",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,127}$",
            "type": "string"
          },
          "session_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "intent": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "source_references": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "maxItems": 50,
            "type": "array"
          },
          "project_id": {
            "maxLength": 128,
            "pattern": "^vault_[a-z0-9][a-z0-9_]*$",
            "type": "string"
          },
          "scope": {
            "enum": [
              "personal",
              "cross-project",
              "system",
              "fleet",
              "project"
            ],
            "type": "string"
          },
          "next_step": {
            "default": "Continue the declared intent.",
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "task_id": {
            "description": "The task's record ID; pass it when the note is for a task",
            "pattern": "^brn_\\d{8}_\\d{6}_[0-9a-f]{4,16}$",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "session_id",
          "intent",
          "source_references"
        ],
        "type": "object"
      }
    },
    {
      "name": "bc_decision_record",
      "description": "Record an accepted decision through its host-resolved canonical owner. Omit source_reference for the current user message; never invent a document reference. Return a truthful receipt. Choose and retain operation_id before calling. After an uncertain response, replay with exactly the same input, never a replacement key. Returns a receipt: saved means status accepted or duplicate with remote_observed true, naming the record in record_id. ",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,127}$",
            "type": "string"
          },
          "scope": {
            "enum": [
              "personal",
              "cross-project",
              "system",
              "fleet",
              "project"
            ],
            "type": "string"
          },
          "title": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "choice": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "because": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "forecloses": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "governing_scope": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "encoded_in": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "completeness_check": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "source_reference": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "project_id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
